{
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": false,
  "dry_run_wallet": 300,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "seconds"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "bybit",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "BTC/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": true,
    "token": "",
    // "token": "",
    "chat_id": "",
    "keyboard": [
        ["/status table","/status","/reload_config"],
        ["/forcelong","/forceshort", "/forceexit"],
        ["/stop", "/start", "/help" ]
    ]
  },
  "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 2,
    "identifier": "test",
    "live_retrain_hours": 0.08,
    "feature_parameters": {
        "include_timeframes": [
            "5m",
            "15m",
            "1h"
        ],
        "include_corr_pairlist": [
            "BNB/USDT",
            "ETH/USDT"
        ],
        "label_period_candles": 20,
        "include_shifted_candles": 2,
        "DI_threshold": 0.9,
        "weight_factor": 0.9,
        "principal_component_analysis": false,
        "use_SVM_to_remove_outliers": true,
        "indicator_periods_candles": [10, 20]
    },
    "data_split_parameters": {
        "test_size": 0,
        "random_state": 1
    },
    "model_training_parameters": {
        "n_estimators": 800
    }
  },
  "bot_name": "freqtrade",
  "initial_state": "running",
  "force_entry_enable": true,
  "internals": {
    "process_throttle_secs": 5
  }
  // "add_config_files": [
  //     "secret.json"
  // ]
}
