{
  "max_open_trades": 1,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 300,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "unfilledtimeout": {
    "entry": 1,
    "exit": 1,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "bybit",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "WIF/USDT:USDT"
      // "RSR/USDT:USDT",
      // "GMT/USDT:USDT",
      // "XAI/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": true,
    "token": "",
    "chat_id": "",
    "keyboard": [
        ["/daily","/stop","/balance","/profit"],
        ["/forcelong","/forceshort"],
        ["/status table","/performance"],
        ["/reload_config","/logs"]
    ]
  },
  "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 15,
    "identifier": "i_1",
    "feature_parameters": {
        "include_corr_pairlist": [
            "BTC/USDT",
            "ETH/USDT"
        ],
        "indicator_periods_candles": [10, 20]
    },
    "rl_config": {
      "train_cycles": 25,
      "add_state_info": true,
      "max_trade_duration_candles": 300,
      "max_training_drawdown_pct": 0.02,
      "cpu_count": 8,
      "model_type": "PPO",
      "policy_type": "MlpPolicy",
      "model_reward_parameters": {
          "rr": 1,
          "profit_aim": 0.025
      }
    },
    "data_split_parameters": {
        // "test_size": 0,
        "random_state": 1
    }
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": []
  },
  "bot_name": "freqtrade",
  "initial_state": "running",
  "force_entry_enable": true,
  "internals": {
    "process_throttle_secs": 5
  },
  "add_config_files": [
      "bybit_secret.json"
  ]
}
